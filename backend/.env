# LLM Provider Configuration (Optimized for Production)
LLM_PROVIDER=ollama
LLM_MODEL=phi3:mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434

# Multi-Model Configuration - Fast & Efficient Models
# Planner Agent - Strategic Planning (phi3:mini - excellent reasoning)
PLANNER_MODEL=phi3:mini
# Researcher Agent - Research & Insights (llama3.2:3b - balanced quality/speed)
RESEARCHER_MODEL=llama3.2:3b
# Writer Agent - Content Creation (gemma:2b - fast generation)
WRITER_MODEL=gemma:2b
# Reviewer Agent - Quality Check (qwen2.5:1.5b - ultra fast)
REVIEWER_MODEL=qwen2.5:1.5b
# Assembler Agent - Final Assembly (phi3:mini - consistent quality)
ASSEMBLER_MODEL=phi3:mini

# Gemini Settings (backup)
GEMINI_API_KEY=AIzaSyCsFbJiB16HpvUCI3KCc7EtU1K4wtOmll8

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
