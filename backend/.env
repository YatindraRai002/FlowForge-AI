# Backend Configuration
# Choose your LLM Provider: "ollama" (local) or "gemini" (cloud)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Ollama Settings (if using ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini Settings (if using gemini - uncomment and add your key)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# Grok Settings (if using grok - uncomment and add your key)
# LLM_PROVIDER=grok
# LLM_MODEL=grok-3
# GROK_API_KEY=your_grok_api_key_here

# Optional: Specialized Models (all use same model by default)
PLANNER_MODEL=llama3.2:3b
RESEARCHER_MODEL=llama3.2:3b
WRITER_MODEL=llama3.2:3b
REVIEWER_MODEL=llama3.2:3b
ASSEMBLER_MODEL=llama3.2:3b

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
VITE_API_BASE_URL=https://flowforge-ai.onrender.com


# Frontend (for local development)
VITE_API_URL=http://localhost:8000
