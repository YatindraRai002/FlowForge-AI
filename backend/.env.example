# FlowForge AI - Environment Configuration
# Groq API Only (Cloud-Ready)

# LLM Configuration
# Supported models: llama-3.1-8b-instant, mixtral-8x7b-32768, llama-3.1-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Groq API Key (REQUIRED)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
