# Backend Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# For Ollama: LLM_PROVIDER=ollama, LLM_MODEL=llama3.2:3b (must match your installed model)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Specialized Models
PLANNER_MODEL=business-analyst
RESEARCHER_MODEL=research-assistant
WRITER_MODEL=code-assistant
REVIEWER_MODEL=data-science-specialist
ASSEMBLER_MODEL=custom-ml-assistant

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Frontend (for local development)
VITE_API_URL=http://localhost:8000
